# Copia este archivo a .env y completa tus credenciales

# OpenAI API Key (o usa tu proveedor de IA local)
OPENAI_API_KEY=""

# Modelo Gemini u otro modelo en tu proveedor de IA
GEMINI_MODEL="gemini-pro"
 
# Backend proxy (opcional, recomendado)
BACKEND_API_URL="http://localhost:3000"
# Credenciales de prueba (solo local) para usar el proxy con JWT
TEST_ADMIN_EMAIL="admin1@example.com"
TEST_ADMIN_PASSWORD="AdminPass1"
